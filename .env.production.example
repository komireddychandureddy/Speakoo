# ─── Speakoo Environment Variables — EXAMPLE FILE ────────────────────────────
#
# Environment strategy (4 tiers):
#   development  — local dev, all services run via Docker Compose
#   bil          — Billing/UAT: Stripe test keys, shared server, pre-prod integration
#   qc           — Quality Control/Staging: mirrors prod topology, final sign-off
#   production   — Live, real Stripe keys, real users
#
# Usage:
#   Copy the relevant file and fill in real secrets:
#     cp .env.example .env.development   → then edit with local values
#   Each tier has its own file: .env.development / .env.bil / .env.qc / .env.production
#   These files are gitignored. Only .env.example is committed.
#
# In CI / CD: secrets are injected via GitHub Actions Secrets or Doppler.
#
# Generate JWT secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://speakoo:changeme@localhost:5432/speakoo_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-another-random-64-char-hex-string

# ─── LiveKit ──────────────────────────────────────────────────────────────────
# dev: local Docker  |  bil/qc/prod: LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880

# ─── Stripe ───────────────────────────────────────────────────────────────────
# dev/bil/qc: sk_test_*  |  prod: sk_live_*
STRIPE_SECRET_KEY=sk_test_replace_with_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_secret
PAYMENT_MOCK_ENABLED=false
PLATFORM_FEE_PERCENT=5

# ─── Resend (https://resend.com) ──────────────────────────────────────────────
RESEND_API_KEY=re_replace_with_key
RESEND_FROM_EMAIL=noreply@speakoo.app

# ─── Twilio WhatsApp ──────────────────────────────────────────────────────────
# dev: use Twilio sandbox (+14155238886)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Object Storage (MinIO locally, Cloudflare R2 in cloud envs) ─────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=speakoo
MINIO_USE_SSL=false

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── CORS / URLs ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# ─── hCaptcha ─────────────────────────────────────────────────────────────────
HCAPTCHA_ENABLED=true
HCAPTCHA_SECRET=replace_with_hcaptcha_secret

# ─── Social Login (OAuth) ─────────────────────────────────────────────────────
# Google OAuth 2.0 Client ID from console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Facebook OAuth from developers.facebook.com/apps
FACEBOOK_APP_ID=REPLACE_ME
FACEBOOK_APP_SECRET=REPLACE_ME

# Apple Sign In from developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=REPLACE_ME
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
APPLE_PRIVATE_KEY=REPLACE_ME
