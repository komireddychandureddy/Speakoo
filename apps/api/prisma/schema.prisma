// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  learner
  tutor
  admin
}

enum SlotStatus {
  available
  booked
  blocked
}

enum BookingStatus {
  pending
  confirmed
  in_session
  completed
  cancelled
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum WalletTransactionType {
  credit
  debit
  refund
  payout
}

enum NotificationType {
  booking_confirmed
  reminder_60min
  reminder_10min
  session_summary
  payout
}

enum NotificationChannel {
  email
  whatsapp
  push
}

enum IncidentCategory {
  abuse
  harassment
  no_show
  payment_dispute
  technical_issue
  other
}

enum IncidentStatus {
  open
  investigating
  resolved
  dismissed
}

enum IncidentPriority {
  low
  medium
  high
  critical
}

enum KycSubmissionStatus {
  pending
  approved
  rejected
}

enum SubscriptionInterval {
  monthly
  yearly
}

enum UserSubscriptionStatus {
  active
  past_due
  canceled
}

enum HomeworkStatus {
  assigned
  submitted
  reviewed
  overdue
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  role            UserRole
  phoneNumber     String?  @unique @map("phone_number")
  isVerified      Boolean  @default(false) @map("is_verified")
  isPhoneVerified Boolean  @default(false) @map("is_phone_verified")
  isSuspended     Boolean  @default(false) @map("is_suspended")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile             UserProfile?
  tutorProfile        TutorProfile?
  bookingsAsLearner   Booking[]            @relation("LearnerBookings")
  bookingsAsTutor     Booking[]            @relation("TutorBookings")
  walletTransactions  WalletTransaction[]
  notificationLogs    NotificationLog[]
  feedbackGiven       SessionFeedback[]    @relation("ReviewerFeedback")
  feedbackReceived    SessionFeedback[]    @relation("RevieweeFeedback")
  learnerPoints       LearnerPoints?
  learnerBadges       LearnerBadge[]
  hostedSessions      PracticeSession[]     @relation("HostedSessions")
  practiceJoins       PracticeParticipant[] @relation("PracticeJoins")
  communityThreads    CommunityThread[]     @relation("ThreadAuthor")
  communityReplies    CommunityReply[]      @relation("ReplyAuthor")
  otpCodes            OtpCode[]
  socialAccounts      SocialAccount[]
  incidentReportsFiled     IncidentReport[] @relation("IncidentReporter")
  incidentReportsAgainst   IncidentReport[] @relation("IncidentReportedUser")
  incidentReportsResolved  IncidentReport[] @relation("IncidentResolver")
  kycSubmissions      TutorKycSubmission[] @relation("KycTutor")
  kycReviews          TutorKycSubmission[] @relation("KycReviewer")
  subscriptions       UserSubscription[]
  learningEnrollments LearnerPathEnrollment[]
  sessionNotesAsLearner SessionNote[] @relation("SessionNoteLearner")
  sessionNotesAsTutor   SessionNote[] @relation("SessionNoteTutor")
  homeworkAsLearner     HomeworkAssignment[] @relation("HomeworkLearner")
  homeworkAsTutor       HomeworkAssignment[] @relation("HomeworkTutor")

  @@map("users")
}

model TutorKycSubmission {
  id                String              @id @default(uuid()) @db.Uuid
  applicationRef    String?             @unique @map("application_ref")
  tutorUserId       String              @map("tutor_user_id") @db.Uuid
  status            KycSubmissionStatus @default(pending)
  documentType      String              @map("document_type")
  documentFrontUrl  String              @map("document_front_url")
  documentBackUrl   String?             @map("document_back_url")
  selfieUrl         String?             @map("selfie_url")
  note              String?             @db.Text
  reviewedById      String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tutor      User  @relation("KycTutor", fields: [tutorUserId], references: [id])
  reviewedBy User? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tutorUserId, createdAt], map: "tutor_kyc_submissions_tutor_created_at_idx")
  @@index([status, createdAt], map: "tutor_kyc_submissions_status_created_at_idx")
  @@map("tutor_kyc_submissions")
}

model UserProfile {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  displayName    String? @map("display_name")
  avatarUrl      String? @map("avatar_url")
  timezone       String  @default("UTC")
  nativeLanguage String? @map("native_language")
  targetLanguage String? @map("target_language")
  learningGoals  String? @map("learning_goals")
  maxBudgetCents Int?    @map("max_budget_cents")
  bio            String?
  countryCode    String? @map("country_code")
  phoneNumber    String? @map("phone_number")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Tutor ────────────────────────────────────────────────────────────────────

model TutorProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  languagesTaught  String[] @map("languages_taught")
  hourlyRateCents  Int      @map("hourly_rate_cents")
  cefrSpecialties  String[] @map("cefr_specialties")
  introVideoUrl    String?  @map("intro_video_url")
  isApproved       Boolean  @default(false) @map("is_approved")
  stripeAccountId  String?  @map("stripe_account_id")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]

  @@map("tutor_profiles")
}

model AvailabilitySlot {
  id        String     @id @default(uuid()) @db.Uuid
  tutorId   String     @map("tutor_id") @db.Uuid
  startTime DateTime   @map("start_time") @db.Timestamptz
  endTime   DateTime   @map("end_time") @db.Timestamptz
  status    SlotStatus @default(available)

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?

  @@map("availability_slots")
}

// ─── Bookings & Sessions ──────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  learnerId        String        @map("learner_id") @db.Uuid
  tutorId          String        @map("tutor_id") @db.Uuid
  slotId           String        @unique @map("slot_id") @db.Uuid
  language         String
  status           BookingStatus @default(pending)
  priceCents       Int           @map("price_cents")
  platformFeeCents Int           @map("platform_fee_cents")
  livekitRoom      String        @map("livekit_room")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  learner           User              @relation("LearnerBookings", fields: [learnerId], references: [id])
  tutor             User              @relation("TutorBookings", fields: [tutorId], references: [id])
  slot              AvailabilitySlot  @relation(fields: [slotId], references: [id])
  session           Session?
  payment           Payment?
  notificationLogs  NotificationLog[]
  incidentReports   IncidentReport[]
  sessionNote       SessionNote?
  homeworkAssignments HomeworkAssignment[]

  @@map("bookings")
}

model IncidentReport {
  id             String           @id @default(uuid()) @db.Uuid
  bookingId      String?          @map("booking_id") @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  category       IncidentCategory
  status         IncidentStatus   @default(open)
  priority       IncidentPriority @default(medium)
  description    String           @db.Text
  evidenceUrls   String[]         @default([]) @map("evidence_urls")
  adminNote      String?          @map("admin_note") @db.Text
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reporter     User     @relation("IncidentReporter", fields: [reporterId], references: [id])
  reportedUser User?    @relation("IncidentReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?    @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt], map: "incident_reports_status_priority_created_at_idx")
  @@index([reporterId, createdAt], map: "incident_reports_reporter_created_at_idx")
  @@map("incident_reports")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  bookingId       String    @unique @map("booking_id") @db.Uuid
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")
  recordingUrl    String?   @map("recording_url")

  booking  Booking           @relation(fields: [bookingId], references: [id])
  feedback SessionFeedback[]

  @@map("sessions")
}

// ─── Payments & Wallet ────────────────────────────────────────────────────────

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  bookingId            String        @unique @map("booking_id") @db.Uuid
  stripePaymentIntent  String?       @map("stripe_payment_intent")
  amountCents          Int           @map("amount_cents")
  currency             String        @default("usd")
  status               PaymentStatus @default(pending)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  type         WalletTransactionType
  amountCents  Int                   @map("amount_cents")
  balanceAfter Int                   @map("balance_after")
  referenceId  String?               @map("reference_id")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model CreditBundle {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  credits     Int
  priceCents  Int     @map("price_cents")
  isActive    Boolean @default(true) @map("is_active")

  @@map("credit_bundles")
}

model SubscriptionPlan {
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @unique
  name            String
  interval        SubscriptionInterval
  priceCents      Int                  @map("price_cents")
  includedCredits Int                  @default(0) @map("included_credits")
  stripePriceId   String?              @map("stripe_price_id")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  planId               String                 @map("plan_id") @db.Uuid
  status               UserSubscriptionStatus @default(active)
  stripeCustomerId     String?                @map("stripe_customer_id")
  stripeSubscriptionId String?                @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime               @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime               @map("current_period_end") @db.Timestamptz
  canceledAt           DateTime?              @map("canceled_at") @db.Timestamptz
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status], map: "user_subscriptions_user_status_idx")
  @@map("user_subscriptions")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model NotificationLog {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  bookingId      String?             @map("booking_id") @db.Uuid
  type           NotificationType
  channel        NotificationChannel
  sentAt         DateTime            @default(now()) @map("sent_at") @db.Timestamptz
  idempotencyKey String              @unique @map("idempotency_key")

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("notification_log")
}

// ─── Feedback & Gamification ──────────────────────────────────────────────────

model SessionFeedback {
  id             String  @id @default(uuid()) @db.Uuid
  sessionId      String  @map("session_id") @db.Uuid
  reviewerId     String  @map("reviewer_id") @db.Uuid
  revieweeId     String  @map("reviewee_id") @db.Uuid
  rating         Int
  comment        String?
  cefrAssessment String? @map("cefr_assessment")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  session  Session @relation(fields: [sessionId], references: [id])
  reviewer User    @relation("ReviewerFeedback", fields: [reviewerId], references: [id])
  reviewee User    @relation("RevieweeFeedback", fields: [revieweeId], references: [id])

  @@map("session_feedback")
}

model LearnerPoints {
  id          String    @id @default(uuid()) @db.Uuid
  learnerId   String    @unique @map("learner_id") @db.Uuid
  points      Int       @default(0)
  streakDays  Int       @default(0) @map("streak_days")
  lastSession DateTime? @map("last_session") @db.Timestamptz

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learner_points")
}

model Badge {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  name    String
  iconUrl String @map("icon_url")

  learnerBadges LearnerBadge[]

  @@map("badges")
}

model LearnerBadge {
  learnerId String   @map("learner_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  earnedAt  DateTime @default(now()) @map("earned_at") @db.Timestamptz

  learner User  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  badge   Badge @relation(fields: [badgeId], references: [id])

  @@id([learnerId, badgeId])
  @@map("learner_badges")
}

// ─── Practice Sessions ────────────────────────────────────────────────────────

enum PracticeSessionType {
  speaking
  reading
  listening
  phonetics
  word_puzzle
  sentence_arrange
}

enum PracticeSessionStatus {
  scheduled
  live
  completed
  cancelled
}

model PracticeSession {
  id              String                @id @default(uuid()) @db.Uuid
  hostId          String                @map("host_id") @db.Uuid
  language        String
  level           String
  title           String
  topic           String
  type            PracticeSessionType
  status          PracticeSessionStatus @default(scheduled)
  scheduledAt     DateTime              @map("scheduled_at") @db.Timestamptz
  durationMinutes Int                   @default(30) @map("duration_minutes")
  maxParticipants Int                   @default(6) @map("max_participants")
  creditCost      Int                   @default(5) @map("credit_cost")
  livekitRoom     String?               @map("livekit_room")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  host         User                  @relation("HostedSessions", fields: [hostId], references: [id])
  participants PracticeParticipant[]

  @@map("practice_sessions")
}

model PracticeParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  learnerId     String   @map("learner_id") @db.Uuid
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz
  creditCharged Int      @map("credit_charged")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner User            @relation("PracticeJoins", fields: [learnerId], references: [id])

  @@unique([sessionId, learnerId])
  @@map("practice_participants")
}

// ─── Community Forum ──────────────────────────────────────────────────────────

enum ThreadCategory {
  question
  discussion
  tip
  resource
}

model CommunityThread {
  id         String         @id @default(uuid()) @db.Uuid
  authorId   String         @map("author_id") @db.Uuid
  language   String
  title      String
  body       String         @db.Text
  category   ThreadCategory
  tags       String[]
  likesCount Int            @default(0) @map("likes_count")
  replyCount Int            @default(0) @map("reply_count")
  isPinned   Boolean        @default(false) @map("is_pinned")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  author  User             @relation("ThreadAuthor", fields: [authorId], references: [id])
  replies CommunityReply[]

  @@map("community_threads")
}

model CommunityReply {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  thread CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User            @relation("ReplyAuthor", fields: [authorId], references: [id])

  @@map("community_replies")
}

// ─── OTP / Verification ───────────────────────────────────────────────────────

enum OtpPurpose {
  email_verification
  phone_verification
  password_reset
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at") @db.Timestamptz
  used      Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ─── Social OAuth Accounts ────────────────────────────────────────────────────

enum SocialProvider {
  google
  facebook
  apple
}

model SocialAccount {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  provider   SocialProvider
  providerId String         @map("provider_id")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

// ─── Learning Outcomes ───────────────────────────────────────────────────────

model LearningPath {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String   @db.Text
  language    String
  cefrLevel   String   @map("cefr_level")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  steps       LearningPathStep[]
  enrollments LearnerPathEnrollment[]

  @@map("learning_paths")
}

model LearningPathStep {
  id          String   @id @default(uuid()) @db.Uuid
  pathId      String   @map("path_id") @db.Uuid
  stepOrder   Int      @map("step_order")
  title       String
  description String   @db.Text
  skill       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, stepOrder], map: "learning_path_steps_path_order_key")
  @@map("learning_path_steps")
}

model LearnerPathEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  learnerId       String   @map("learner_id") @db.Uuid
  pathId          String   @map("path_id") @db.Uuid
  currentStepOrder Int     @default(1) @map("current_step_order")
  progressPercent Int      @default(0) @map("progress_percent")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  learner User         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([learnerId, pathId], map: "learner_path_enrollments_learner_path_key")
  @@map("learner_path_enrollments")
}

model SessionNote {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  learnerId  String   @map("learner_id") @db.Uuid
  tutorId    String   @map("tutor_id") @db.Uuid
  summary    String   @db.Text
  strengths  String?  @db.Text
  weaknesses String?  @db.Text
  nextSteps  String?  @map("next_steps") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  learner User    @relation("SessionNoteLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  tutor   User    @relation("SessionNoteTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt], map: "session_notes_learner_created_at_idx")
  @@map("session_notes")
}

model HomeworkAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  learnerId      String         @map("learner_id") @db.Uuid
  tutorId        String?        @map("tutor_id") @db.Uuid
  bookingId      String?        @map("booking_id") @db.Uuid
  title          String
  description    String         @db.Text
  dueAt          DateTime?      @map("due_at") @db.Timestamptz
  status         HomeworkStatus @default(assigned)
  submissionText String?        @map("submission_text") @db.Text
  feedbackText   String?        @map("feedback_text") @db.Text
  reviewedAt     DateTime?      @map("reviewed_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  learner User     @relation("HomeworkLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  tutor   User?    @relation("HomeworkTutor", fields: [tutorId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([learnerId, status, createdAt], map: "homework_assignments_learner_status_created_at_idx")
  @@map("homework_assignments")
}
