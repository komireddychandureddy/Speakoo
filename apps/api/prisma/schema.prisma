// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  learner
  tutor
  admin
}

enum SlotStatus {
  available
  booked
  blocked
}

enum BookingStatus {
  pending
  confirmed
  in_session
  completed
  cancelled
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum WalletTransactionType {
  credit
  debit
  refund
  payout
}

enum NotificationType {
  booking_confirmed
  reminder_60min
  reminder_10min
  session_summary
  payout
}

enum NotificationChannel {
  email
  whatsapp
  push
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile             UserProfile?
  tutorProfile        TutorProfile?
  bookingsAsLearner   Booking[]            @relation("LearnerBookings")
  bookingsAsTutor     Booking[]            @relation("TutorBookings")
  walletTransactions  WalletTransaction[]
  notificationLogs    NotificationLog[]
  feedbackGiven       SessionFeedback[]    @relation("ReviewerFeedback")
  feedbackReceived    SessionFeedback[]    @relation("RevieweeFeedback")
  learnerPoints       LearnerPoints?
  learnerBadges       LearnerBadge[]
  hostedSessions      PracticeSession[]     @relation("HostedSessions")
  practiceJoins       PracticeParticipant[] @relation("PracticeJoins")
  communityThreads    CommunityThread[]     @relation("ThreadAuthor")
  communityReplies    CommunityReply[]      @relation("ReplyAuthor")

  @@map("users")
}

model UserProfile {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  displayName    String? @map("display_name")
  avatarUrl      String? @map("avatar_url")
  timezone       String  @default("UTC")
  nativeLanguage String? @map("native_language")
  bio            String?
  countryCode    String? @map("country_code")
  phoneNumber    String? @map("phone_number")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Tutor ────────────────────────────────────────────────────────────────────

model TutorProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  languagesTaught  String[] @map("languages_taught")
  hourlyRateCents  Int      @map("hourly_rate_cents")
  cefrSpecialties  String[] @map("cefr_specialties")
  introVideoUrl    String?  @map("intro_video_url")
  isApproved       Boolean  @default(false) @map("is_approved")
  stripeAccountId  String?  @map("stripe_account_id")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]

  @@map("tutor_profiles")
}

model AvailabilitySlot {
  id        String     @id @default(uuid()) @db.Uuid
  tutorId   String     @map("tutor_id") @db.Uuid
  startTime DateTime   @map("start_time") @db.Timestamptz
  endTime   DateTime   @map("end_time") @db.Timestamptz
  status    SlotStatus @default(available)

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?

  @@map("availability_slots")
}

// ─── Bookings & Sessions ──────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  learnerId        String        @map("learner_id") @db.Uuid
  tutorId          String        @map("tutor_id") @db.Uuid
  slotId           String        @unique @map("slot_id") @db.Uuid
  language         String
  status           BookingStatus @default(pending)
  priceCents       Int           @map("price_cents")
  platformFeeCents Int           @map("platform_fee_cents")
  livekitRoom      String        @map("livekit_room")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  learner           User              @relation("LearnerBookings", fields: [learnerId], references: [id])
  tutor             User              @relation("TutorBookings", fields: [tutorId], references: [id])
  slot              AvailabilitySlot  @relation(fields: [slotId], references: [id])
  session           Session?
  payment           Payment?
  notificationLogs  NotificationLog[]

  @@map("bookings")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  bookingId       String    @unique @map("booking_id") @db.Uuid
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")
  recordingUrl    String?   @map("recording_url")

  booking  Booking           @relation(fields: [bookingId], references: [id])
  feedback SessionFeedback[]

  @@map("sessions")
}

// ─── Payments & Wallet ────────────────────────────────────────────────────────

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  bookingId            String        @unique @map("booking_id") @db.Uuid
  stripePaymentIntent  String?       @map("stripe_payment_intent")
  amountCents          Int           @map("amount_cents")
  currency             String        @default("usd")
  status               PaymentStatus @default(pending)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  type         WalletTransactionType
  amountCents  Int                   @map("amount_cents")
  balanceAfter Int                   @map("balance_after")
  referenceId  String?               @map("reference_id")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model CreditBundle {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  credits     Int
  priceCents  Int     @map("price_cents")
  isActive    Boolean @default(true) @map("is_active")

  @@map("credit_bundles")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model NotificationLog {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  bookingId      String?             @map("booking_id") @db.Uuid
  type           NotificationType
  channel        NotificationChannel
  sentAt         DateTime            @default(now()) @map("sent_at") @db.Timestamptz
  idempotencyKey String              @unique @map("idempotency_key")

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("notification_log")
}

// ─── Feedback & Gamification ──────────────────────────────────────────────────

model SessionFeedback {
  id             String  @id @default(uuid()) @db.Uuid
  sessionId      String  @map("session_id") @db.Uuid
  reviewerId     String  @map("reviewer_id") @db.Uuid
  revieweeId     String  @map("reviewee_id") @db.Uuid
  rating         Int
  comment        String?
  cefrAssessment String? @map("cefr_assessment")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  session  Session @relation(fields: [sessionId], references: [id])
  reviewer User    @relation("ReviewerFeedback", fields: [reviewerId], references: [id])
  reviewee User    @relation("RevieweeFeedback", fields: [revieweeId], references: [id])

  @@map("session_feedback")
}

model LearnerPoints {
  id          String    @id @default(uuid()) @db.Uuid
  learnerId   String    @unique @map("learner_id") @db.Uuid
  points      Int       @default(0)
  streakDays  Int       @default(0) @map("streak_days")
  lastSession DateTime? @map("last_session") @db.Timestamptz

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learner_points")
}

model Badge {
  id      String @id @default(uuid()) @db.Uuid
  slug    String @unique
  name    String
  iconUrl String @map("icon_url")

  learnerBadges LearnerBadge[]

  @@map("badges")
}

model LearnerBadge {
  learnerId String   @map("learner_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  earnedAt  DateTime @default(now()) @map("earned_at") @db.Timestamptz

  learner User  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  badge   Badge @relation(fields: [badgeId], references: [id])

  @@id([learnerId, badgeId])
  @@map("learner_badges")
}

// ─── Practice Sessions ────────────────────────────────────────────────────────

enum PracticeSessionType {
  speaking
  reading
  listening
  phonetics
  word_puzzle
  sentence_arrange
}

enum PracticeSessionStatus {
  scheduled
  live
  completed
  cancelled
}

model PracticeSession {
  id              String                @id @default(uuid()) @db.Uuid
  hostId          String                @map("host_id") @db.Uuid
  language        String
  level           String
  title           String
  topic           String
  type            PracticeSessionType
  status          PracticeSessionStatus @default(scheduled)
  scheduledAt     DateTime              @map("scheduled_at") @db.Timestamptz
  durationMinutes Int                   @default(30) @map("duration_minutes")
  maxParticipants Int                   @default(6) @map("max_participants")
  creditCost      Int                   @default(5) @map("credit_cost")
  livekitRoom     String?               @map("livekit_room")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  host         User                  @relation("HostedSessions", fields: [hostId], references: [id])
  participants PracticeParticipant[]

  @@map("practice_sessions")
}

model PracticeParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  learnerId     String   @map("learner_id") @db.Uuid
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz
  creditCharged Int      @map("credit_charged")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner User            @relation("PracticeJoins", fields: [learnerId], references: [id])

  @@unique([sessionId, learnerId])
  @@map("practice_participants")
}

// ─── Community Forum ──────────────────────────────────────────────────────────

enum ThreadCategory {
  question
  discussion
  tip
  resource
}

model CommunityThread {
  id         String         @id @default(uuid()) @db.Uuid
  authorId   String         @map("author_id") @db.Uuid
  language   String
  title      String
  body       String         @db.Text
  category   ThreadCategory
  tags       String[]
  likesCount Int            @default(0) @map("likes_count")
  replyCount Int            @default(0) @map("reply_count")
  isPinned   Boolean        @default(false) @map("is_pinned")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  author  User             @relation("ThreadAuthor", fields: [authorId], references: [id])
  replies CommunityReply[]

  @@map("community_threads")
}

model CommunityReply {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  thread CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User            @relation("ReplyAuthor", fields: [authorId], references: [id])

  @@map("community_replies")
}
