# =============================================================================
# Speakoo API — Environment Variables
# Copy this file to .env and fill in all values before running the server.
# NEVER commit .env with real values.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://speakoo:REPLACE_ME@localhost:5434/speakoo_dev

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string (used for Bull queues, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Access token secret — min 32 random characters (e.g. openssl rand -hex 32)
JWT_SECRET=REPLACE_ME

# Refresh token secret — different from JWT_SECRET, same length requirement
JWT_REFRESH_SECRET=REPLACE_ME

# ── Application ──────────────────────────────────────────────────────────────
# Server port (default 3000 if omitted)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Display name used in email subjects
APP_NAME=Speakoo

# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://speakoo.duckdns.org

# ── Email (Resend) ───────────────────────────────────────────────────────────
# API key from resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME

# Verified sender address configured in your Resend account
RESEND_FROM_EMAIL=Speakoo <noreply@speakoo.com>
# Resend Dashboard template ID for OTP emails (must be Published, not Draft)
RESEND_OTP_TEMPLATE_ID=REPLACE_WITH_TEMPLATE_ID

# ── WhatsApp / SMS (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACREPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
# Format: whatsapp:+<number> — must be a Twilio WhatsApp-enabled sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── LiveKit (Video Sessions) ─────────────────────────────────────────────────
# Generate a key/secret pair in the LiveKit Cloud dashboard or your self-hosted deployment
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# WebSocket URL of your LiveKit server (no trailing slash)
LIVEKIT_WS_URL=ws://localhost:7880

# Dev-only: used by docker-compose.yml to set LIVEKIT_KEYS (key:secret, no space)
LIVEKIT_DEV_KEY=devkey
LIVEKIT_DEV_SECRET=devsecret_min_32_chars_long_replace

# ── Stripe (Payments) ────────────────────────────────────────────────────────
# Secret key from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret from the Stripe CLI or dashboard endpoint config
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Object Storage (MinIO / Cloudflare R2) ───────────────────────────────────
# Hostname + port of your MinIO instance (no protocol prefix)
MINIO_ENDPOINT=localhost:9000

# Access key (analogous to AWS_ACCESS_KEY_ID)
MINIO_ACCESS_KEY=REPLACE_ME

# Secret key (analogous to AWS_SECRET_ACCESS_KEY)
MINIO_SECRET_KEY=REPLACE_ME

# Set to true when connecting to HTTPS-enabled MinIO or S3-compatible endpoints
MINIO_USE_SSL=false

# ── Platform Config ──────────────────────────────────────────────────────────
# Platform fee percentage deducted from tutor payouts (integer)
PLATFORM_FEE_PERCENT=5

# ── Monitoring (Grafana) ─────────────────────────────────────────────────────
# Password for the Grafana admin user (used in docker-compose.yml)
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME

# ── Production Deploy (Docker Compose prod override) ─────────────────────────
# GitHub Container Registry owner (your GitHub username or org)
GHCR_OWNER=REPLACE_ME

# Docker image tag used in docker-compose.prod.yml
IMAGE_TAG=latest

# ── hCaptcha (CAPTCHA on register/login endpoints) ─────────────────────────────────
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=REPLACE_ME

# ── Social Login (OAuth) ─────────────────────────────────────────────────────
# Google OAuth 2.0 Client ID from console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Facebook OAuth from developers.facebook.com/apps
FACEBOOK_APP_ID=REPLACE_ME
FACEBOOK_APP_SECRET=REPLACE_ME

# Apple Sign In from developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=REPLACE_ME
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
APPLE_PRIVATE_KEY=REPLACE_ME
