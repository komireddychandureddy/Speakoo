# =============================================================================
# Speakoo Docker Compose — Environment Variables
# Copy this file to .env and fill in all values before deploying.
# NEVER commit .env with real values.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the 'speakoo' database user (min 20 random characters)
POSTGRES_PASSWORD=REPLACE_ME

# ── MinIO (Object Storage) ───────────────────────────────────────────────────
# MinIO root user (analogous to AWS_ACCESS_KEY_ID, min 3 chars)
MINIO_ROOT_USER=REPLACE_ME

# MinIO root password (min 8 chars)
MINIO_ROOT_PASSWORD=REPLACE_ME

# ── LiveKit (Dev only — not used in production) ──────────────────────────────
LIVEKIT_DEV_KEY=devkey
LIVEKIT_DEV_SECRET=REPLACE_ME_min_32_chars_long

# ── Grafana ───────────────────────────────────────────────────────────────────
# Grafana admin dashboard password
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME

# ── Production Docker Image (required for deploy.sh / update.sh) ─────────────
# Your GitHub username or organisation (owner of the GHCR package)
# e.g. komireddychandureddy
GHCR_OWNER=REPLACE_ME

# Tag of the pre-built API image to deploy
# Use 'latest' or a specific SHA/tag from your CI pipeline
IMAGE_TAG=latest
