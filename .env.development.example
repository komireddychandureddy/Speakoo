# ─── Environment: development (local) ────────────────────────────────────────
# Copy to .env or load via NODE_ENV=development
# All services run locally via Docker Compose (infra/docker/docker-compose.yml)

NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://speakoo:changeme@localhost:5432/speakoo_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-another-random-64-char-hex-string

# ─── LiveKit (local Docker) ───────────────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880

# ─── Stripe (test mode keys) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_webhook_secret
PAYMENT_MOCK_ENABLED=true
PLATFORM_FEE_PERCENT=5

# ─── Resend (dev — use your test API key or Resend sandbox) ───────────────────
RESEND_API_KEY=re_replace_with_dev_key
RESEND_FROM_EMAIL=noreply@dev.speakoo.app

# ─── Twilio WhatsApp (dev sandbox) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_dev_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── MinIO (local Docker) ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=speakoo
MINIO_USE_SSL=false

# ─── Sentry (optional in dev — leave blank to disable) ───────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
APP_URL=http://localhost:3000

# ─── hCaptcha ─────────────────────────────────────────────────────────────────
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=replace_with_hcaptcha_secret
FRONTEND_URL=http://localhost:8080

# ─── Social Login (OAuth) ─────────────────────────────────────────────────────
# Google OAuth 2.0 Client ID from console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Facebook OAuth from developers.facebook.com/apps
FACEBOOK_APP_ID=REPLACE_ME
FACEBOOK_APP_SECRET=REPLACE_ME

# Apple Sign In from developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=REPLACE_ME
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
APPLE_PRIVATE_KEY=REPLACE_ME
